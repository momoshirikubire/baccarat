rules_version = '2';
// バカラノート（Web）のテーブル。Firebase コンソールの Firestore →「ルール」に貼って公開する。
// tables/{4桁の番号}：親だけが書く（12時間さわられていない番号は、ほかの人が新しいテーブルに使える）。
// tables/{番号}/players/{uid}：プレイヤーは自分の分だけを書く。親がそれを読んで確かめ、テーブルに入れる。
service cloud.firestore {
  match /databases/{database}/documents {
    match /tables/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && code.matches('^[0-9]{4}$')
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['hostUid', 'touchedAt', 'open', 'state', 'ended'])
        && request.resource.data.state.size() < 600000;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['hostUid', 'touchedAt', 'open', 'state', 'ended'])
        && request.resource.data.state.size() < 600000
        && (
          (resource.data.hostUid == request.auth.uid && request.resource.data.hostUid == request.auth.uid)
          || (request.resource.data.hostUid == request.auth.uid
              && request.time.toMillis() - resource.data.touchedAt > 12 * 60 * 60 * 1000)
        );
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;

      match /players/{uid} {
        allow read: if request.auth != null
          && (request.auth.uid == uid || get(/databases/$(database)/documents/tables/$(code)).data.hostUid == request.auth.uid);
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'tableId', 'joinedAt', 'left', 'bet', 'betAt', 'rebuyAt', 'give'])
          && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 20))
          && (!('bet' in request.resource.data) || request.resource.data.bet.size() < 400);
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
